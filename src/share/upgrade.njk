---
title: "Refueler Share — Upgrade"
description: "Upgrade your Refueler Share plan for larger files and longer expiry."
permalink: /upgrade.html
activePage: "upgrade"
stripeThemeRemount: true
---
<!DOCTYPE html>
<html lang="en">
<head>
{% set extraHead %}
<link rel="stylesheet" href="/upgrade.css">
<script src="https://js.stripe.com/v3/"></script>
{% endset %}
{% include "head.njk" %}
<!-- ── Status banner (hidden until JS populates from /status) ─────────────── -->
<div class="status-banner hidden" id="status-banner" role="alert" aria-live="polite">
  <span class="status-banner-icon" id="status-banner-icon"></span>
  <span class="status-banner-text" id="status-banner-text"></span>
  <a class="status-banner-link" href="/status.html" id="status-banner-link">View status →</a>
  <button class="status-banner-dismiss" id="status-banner-dismiss" aria-label="Dismiss">✕</button>
</div>

<script>
(function () {
  const WORKER_URL   = 'https://api.share.refueler.io';
  const DISMISS_KEY  = 'rs-banner-dismissed';
  const banner       = document.getElementById('status-banner');
  const bannerIcon   = document.getElementById('status-banner-icon');
  const bannerText   = document.getElementById('status-banner-text');
  const bannerDismiss = document.getElementById('status-banner-dismiss');

  bannerDismiss.addEventListener('click', () => {
    banner.classList.add('hidden');
    try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch {}
  });

  async function loadStatus() {
    try { if (sessionStorage.getItem(DISMISS_KEY)) return; } catch {}

    let status;
    try {
      const res = await fetch(`${WORKER_URL}/status`, { cache: 'no-store' });
      if (!res.ok) return;
      status = await res.json();
    } catch {
      return;
    }

    const state = status.state ?? 'operational';
    if (state === 'operational') return;

    banner.dataset.state = state;

    if (state === 'maintenance') {
      bannerIcon.textContent = '🔧';
      const mw = status.maintenance;
      if (mw && mw.scheduled_at) {
        const dt = new Date(mw.scheduled_at * 1000);
        const formatted = dt.toLocaleString('en-GB', {
          weekday: 'short', day: 'numeric', month: 'short',
          hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
        });
        const dur = mw.duration_minutes ? ` (${mw.duration_minutes} min)` : '';
        const desc = mw.description ? ` — ${mw.description}` : '';
        bannerText.textContent = `Scheduled maintenance: ${formatted}${dur}${desc}`;
      } else {
        bannerText.textContent = status.message ?? 'Maintenance in progress.';
      }
    } else if (state === 'degraded') {
      bannerIcon.textContent = '⚠️';
      bannerText.textContent = status.message ?? 'Some services are degraded — we are investigating.';
    }

    banner.classList.remove('hidden');
  }

  loadStatus();
})();
</script>

{% include "shared-styles.njk" %}
</head>
<body>

{% set activePage = "upgrade" %}
{% include "nav.njk" %}

<!-- ── Main page ─────────────────────────────────────────────────────── -->
<div class="page" id="mainPage">

  <a href="/index.html" class="upgrade-back-link">← Back to Refueler Share</a>

  <div class="page-header">
    <h1>Choose your plan</h1>
    <p>Free transfers need no account. Upgrade for larger files and longer expiry.</p>
    <div class="soft-launch-notice">Free tier open · Paid plans launching soon</div>
  </div>

  <!-- Billing toggle -->
  <div class="billing-toggle">
    <span class="toggle-label active" id="labelMonthly">Monthly</span>
    <div class="toggle-switch" id="billingToggle" onclick="toggleBilling()">
      <div class="toggle-knob"></div>
    </div>
    <span class="toggle-label" id="labelYearly">Yearly</span>

  </div>

  <!-- Tier cards -->
  <div class="tiers">

    <!-- Free -->
    <div class="tier-card free-card">
      <div class="current-plan-tag">Current</div>
      <div class="tier-label">Citizen</div>
      <div class="tier-name">Citizen</div>
      <div class="tier-price">
        <span class="tier-price-main">£0</span>
        <span class="tier-price-period">/ forever</span>
      </div>
      <div class="tier-yearly">&nbsp;</div>
      <ul class="tier-features">
        <li>4 GB per transfer</li>
        <li>1 / 7 day expiry</li>
        <li>End-to-end encrypted</li>
        <li>No account needed</li>
      </ul>
    </div>

    <!-- Sovereign -->
    <div class="tier-card coming-soon" id="card-max">
      <div class="coming-soon-tag">Coming Soon</div>
      <div class="tier-label gold">Sovereign</div>
      <div class="tier-name">Sovereign</div>
      <div class="tier-price">
        <span class="tier-price-main" id="price-max">£24</span>
        <span class="tier-price-period" id="period-max">/ month</span>
      </div>
      <div class="tier-yearly" id="yearly-max">or £288/yr</div>
      <ul class="tier-features">
        <li>250 GB per transfer</li>
        <li>1 / 7 / 30 / 90 day expiry</li>
        <li>End-to-end encrypted</li>
        <li>Password-protected downloads</li>
        <li>Lightning payments</li>
        <li>Priority transfers</li>
      </ul>
    </div>

  </div>

  <!-- Payment section -->
  <div class="payment-section" id="paymentSection">
    <div class="payment-header">
      <div class="payment-title">Payment</div>
      <div class="payment-summary" id="paymentSummary">Sovereign — £24/month</div>
    </div>

    <div class="payment-tabs">
      <div class="pay-tab active" onclick="switchTab('card')">Card</div>
      <div class="pay-tab" onclick="switchTab('lightning')">⚡ Lightning <span style="font-size:10px;color:var(--fg-subtle);margin-left:4px;">Coming soon</span></div>
    </div>

    <!-- Card tab -->
    <div class="tab-pane active" id="tab-card">
      <div class="status-msg" id="statusMsg"></div>

      <div class="field">
        <label>Email address</label>
        <input type="email" id="emailInput" placeholder="you@example.com" autocomplete="email" />
      </div>

      <div id="stripe-element-container">
        <div id="payment-element"></div>
      </div>

      <button class="btn-subscribe" id="submitBtn" onclick="handleSubmit()">Subscribe now</button>

      <p class="payment-note">
        Secured by <a href="https://stripe.com" target="_blank" rel="noopener">Stripe</a>
      </p>
    </div>

    <!-- Lightning tab -->
    <div class="tab-pane" id="tab-lightning">
      <div class="lightning-placeholder">
        <div class="lp-icon">⚡</div>
        <p>Lightning payments are coming in a future update.<br>Pay with sats via BOLT11 invoice.</p>
      </div>
    </div>
  </div>

</div>

<!-- Success panel -->
<div class="page">
  <div class="success-panel" id="successPanel">
    <div class="success-icon">✓</div>
    <h2>You're all set</h2>
    <p>Your subscription is active. Start sending large files now.</p>
    <a class="btn btn-primary" href="/">Go to upload →</a>
  </div>
</div>

{% include "footer.njk" %}

<script>
const WORKER_URL = 'https://api.share.refueler.io';
const STRIPE_PK  = 'pk_live_qTLdmzRXg6KHXtxbgGYQZc7L00Kl4saD2q';

const PRICE_IDS = {
  creative: {
    monthly: 'price_1Ts7lsGlctwiB9U3hdtgChU2',
    yearly:  'price_1Ts7sqGlctwiB9U3YRloCFfi',
  },
  max: {
    monthly: 'price_1Ts7vIGlctwiB9U3kb3NCLue',
    yearly:  'price_1Ts7xIGlctwiB9U3JyZB8Kwj',
  },
};

const PRICES_DISPLAY = {
  creative: { monthly: { price: '£12', period: '/ month' }, yearly: { price: '£144', period: '/ year' } },
  max:      { monthly: { price: '£24', period: '/ month' }, yearly: { price: '£288', period: '/ year' } },
};

let selectedTier   = 'creative';
let billingYearly  = false;
let stripe         = null;
let elements       = null;
let paymentElement = null;

// ── URL param handling ──────────────────────────────────────────
const params = new URLSearchParams(location.search);
if (params.get('success') === '1') {
  document.getElementById('mainPage').style.display = 'none';
  document.getElementById('successPanel').classList.add('visible');
}

// ── Theme-aware Stripe remount ──────────────────────────────────
function remountStripeForTheme() {
  if (!elements) return;
  const email = document.getElementById('emailInput').value.trim();
  if (email && email.includes('@') && stripe) {
    elements = null;
    paymentElement = null;
    document.getElementById('payment-element').innerHTML = '';
    mountPaymentElement();
  }
}

// ── Billing toggle ──────────────────────────────────────────────
function toggleBilling() {
  billingYearly = !billingYearly;
  const toggle = document.getElementById('billingToggle');
  toggle.classList.toggle('on', billingYearly);
  document.getElementById('labelMonthly').classList.toggle('active', !billingYearly);
  document.getElementById('labelYearly').classList.toggle('active', billingYearly);
  updatePriceDisplay();
  updateSummary();
  resetPaymentElement();
}

function updatePriceDisplay() {
  ['creative', 'max'].forEach(tier => {
    const d = PRICES_DISPLAY[tier][billingYearly ? 'yearly' : 'monthly'];
    document.getElementById(`price-${tier}`).textContent = d.price;
    document.getElementById(`period-${tier}`).textContent = d.period;
  });
}

// ── Tier selection ──────────────────────────────────────────────
function selectTier(tier) {
  const card = document.getElementById(`card-${tier}`);
  if (!card || card.classList.contains('coming-soon')) return;
  selectedTier = tier;
  document.querySelectorAll('.tier-card').forEach(c => c.classList.remove('selected'));
  document.getElementById(`card-${tier}`).classList.add('selected');
  updateSummary();
  resetPaymentElement();
}

function updateSummary() {
  const names   = { max: 'Sovereign' };
  const billing = billingYearly ? 'yearly' : 'monthly';
  const d       = PRICES_DISPLAY[selectedTier][billing];
  document.getElementById('paymentSummary').textContent =
    `${names[selectedTier]} — ${d.price}${d.period.replace('/', '').trim()}`;
}

function resetPaymentElement() {
  elements = null;
  paymentElement = null;
  document.getElementById('payment-element').innerHTML = '';
  const email = document.getElementById('emailInput').value.trim();
  if (email && email.includes('@') && stripe) mountPaymentElement();
}

// ── Stripe ──────────────────────────────────────────────────────
async function initStripe() {
  stripe = Stripe(STRIPE_PK);
  await mountPaymentElement();
}

async function mountPaymentElement() {
  const priceId = PRICE_IDS[selectedTier][billingYearly ? 'yearly' : 'monthly'];
  const email   = document.getElementById('emailInput').value.trim();
  if (!email) return;

  showStatus('');
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Loading…';

  try {
    const res = await fetch(`${WORKER_URL}/subscription/checkout`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ price_id: priceId, email }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Checkout failed');

    if (elements) elements.unmount();
    elements = stripe.elements({
      clientSecret: data.client_secret,
      appearance: stripeAppearance(),
    });
    paymentElement = elements.create('payment');
    paymentElement.mount('#payment-element');
    paymentElement.on('ready', () => {
      btn.disabled = false;
      btn.textContent = 'Subscribe now';
    });
  } catch (e) {
    showStatus(e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Subscribe now';
  }
}

async function handleSubmit() {
  const email = document.getElementById('emailInput').value.trim();
  if (!email || !email.includes('@')) {
    showStatus('Please enter a valid email address.', 'error');
    return;
  }
  if (!elements) {
    await mountPaymentElement();
    return;
  }
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Processing…';
  showStatus('');

  const { error } = await stripe.confirmPayment({
    elements,
    confirmParams: {
      return_url:     `${location.origin}/upgrade.html?success=1`,
      receipt_email:  email,
    },
    redirect: 'if_required',
  });

  if (error) {
    showStatus(error.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Subscribe now';
  } else {
    document.getElementById('mainPage').style.display = 'none';
    const successPanel = document.getElementById('successPanel');
    successPanel.classList.add('visible');
  }
}

// Mount Stripe on email blur
document.getElementById('emailInput').addEventListener('blur', () => {
  const email = document.getElementById('emailInput').value.trim();
  if (email && email.includes('@') && !elements) initStripe();
});

// ── Tab switching ───────────────────────────────────────────────
function switchTab(tab) {
  const isCard = tab === 'card';
  document.querySelectorAll('.pay-tab').forEach((t, i) => t.classList.toggle('active', isCard ? i === 0 : i === 1));
  document.querySelectorAll('.tab-pane').forEach((p, i) => p.classList.toggle('active', isCard ? i === 0 : i === 1));
}

// ── Status messages ─────────────────────────────────────────────
function showStatus(msg, type = '') {
  const el = document.getElementById('statusMsg');
  el.textContent = msg;
  el.className = `status-msg${type ? ' ' + type : ''}`;
}


// ── Stripe appearance — theme-aware ────────────────────────────
function stripeAppearance() {
const isDark = document.documentElement.dataset.theme === 'carbon';
  return {
    theme: isDark ? 'night' : 'stripe',
    variables: {
      colorPrimary:     '#C8A96E',
      colorBackground:  isDark ? '#252525' : '#FFFFFF',
      colorText:        isDark ? '#F5F0E8' : '#1A1A1A',
      colorDanger:      isDark ? '#E05555' : '#C0392B',
      fontFamily:       'DM Sans, sans-serif',
      borderRadius:     '6px',
    },
  };
}
</script>
</body>
</html>
