---
title: "Refueler — Your transaction is nobody else's business."
description: "Privacy infrastructure. Encrypted transfers, private Bitcoin explorer, and Lightning payments."
canonical: "https://refueler.io/"
permalink: /index.html
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  {% include "head.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/home.css">
</head>

<body>

  {% include "nav.njk" %}

  <main>
    <div class="home-hero">

      <p class="home-overline"><span class="home-overline-rule"></span>Privacy Infrastructure · London</p>

      <h1 class="home-headline">Your transaction<br>is nobody else's<br>business.</h1>

      <div class="home-subhead-band">
        <p class="home-subhead">Privacy isn't a feature. It's the architecture.</p>
      </div>

      <div class="home-caps">

        <div class="home-cap">
          <span class="home-cap-label">Encrypted transfers</span>
          <p class="home-cap-desc">The server is blind, so is the till.</p>
        </div>

        <div class="home-cap">
          <span class="home-cap-label">Bitcoin explorer</span>
          <p class="home-cap-desc">Your search history is showing.</p>
        </div>

        <div class="home-cap">
          <span class="home-cap-label">Lightning payments</span>
          <p class="home-cap-desc">Tap and go. Sats or card, your call.</p>
        </div>

      </div>

    </div>
  </main>

  {% include "footer.njk" %}

  <!-- Mobile auth deep-link handler (PKCE callback for consumer app) -->
  <script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('mobileAuth') !== '1') return;

    var code = params.get('code');
    var errorDescription = params.get('error_description');

    if (errorDescription) {
      document.body.innerHTML = '<p style="font-family:sans-serif;padding:40px;text-align:center;">Sign-in failed: ' + errorDescription + '</p>';
      return;
    }
    if (!code) {
      document.body.innerHTML = '<p style="font-family:sans-serif;padding:40px;text-align:center;">Missing sign-in code. Please request a new link.</p>';
      return;
    }

    var deepLink = 'refuelerapp://login-callback?code=' + encodeURIComponent(code);

    document.body.innerHTML =
      '<div style="font-family:sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center;background:#1A1A1A;color:#F5F0E8;">' +
        '<p style="font-size:16px;margin-bottom:24px;">You\'re signed in.</p>' +
        '<button id="rfContinueBtn" style="font-family:sans-serif;font-size:16px;font-weight:600;padding:14px 32px;border-radius:999px;border:none;background:#C8A96E;color:#1A1A1A;cursor:pointer;">Continue to Refueler</button>' +
      '</div>';

    document.getElementById('rfContinueBtn').addEventListener('click', function () {
      window.location.href = deepLink;
    });

    try { window.location.href = deepLink; } catch (e) {}
  })();
  </script>

  <script src="/analytics.js" defer></script>

</body>
</html>
