  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/home.css' | cssv }}">
</head>

<body>

  {% include "nav.njk" %}

  <main>
    <div class="home-hero">

      <div class="home-top">

        <div>
          <p class="home-overline"><span class="home-overline-rule"></span>London</p>
          <h1 class="home-headline">Privacy<br>infrastructure.</h1>
        </div>

        <div class="home-code">
          <div class="home-code-head">
            <span>refueler_send_file</span>
            <span class="home-status home-status-build">MCP · In build</span>
          </div>
<pre><span class="c">// encrypted on your machine; only sealed data leaves</span>
{
  <span class="k">"file_path"</span>: "./board-pack.pdf",
  <span class="k">"destroy_after_download"</span>: true
}
<span class="c">// → share_url · expires_at · cost_credits</span></pre>
          <div class="home-code-cap">Share, called by an AI agent. Not yet released.</div>
        </div>

      </div>

      <div class="home-caps">

        <div class="home-cap">
          <span class="home-cap-label">Share</span>
          <p class="home-cap-desc">Encrypted file transfer.</p>
          <div class="home-cap-status"><span class="home-status home-status-live">Web · Live</span><span class="home-status home-status-build">MCP · In build</span></div>
        </div>

        <div class="home-cap">
          <span class="home-cap-label">Legend</span>
