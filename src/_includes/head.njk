<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
{% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% endif %}
<meta name="robots" content="index, follow" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
{% if canonical %}<meta property="og:url" content="{{ canonical }}" />{% endif %}
<meta property="og:title" content="{{ title }}" />
{% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
<meta property="og:site_name" content="Refueler" />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="{{ title }}" />
{% if description %}<meta name="twitter:description" content="{{ description }}" />{% endif %}

<!-- Fonts: Satoshi · DM Sans · IBM Plex Mono · Source Serif 4 -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,300&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" />

<!-- Global styles: tokens, reset, nav, footer -->
<link rel="stylesheet" href="{{ '/assets/css/global.css' | cssv }}" />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
<meta name="theme-color" content="#1A1917" />

{{ extraHead | safe }}

<!-- Theme: applied before first paint.
     Detection: document.documentElement.dataset.theme === 'carbon'
     Persistence: localStorage rs-theme, never a cookie (Privacy-Share-1, 16 Oct 2026). The old
     .refueler.io cookie is read once, moved into localStorage, then expired.
     Carbon is default on the whole site (R-13). A visitor's saved choice wins.
     The pill label is set again once the page has loaded: the pill doesn't exist yet
     when this runs (F-7). theme-color (browser toolbar tint) follows the page's --bg. -->
<!-- X5-2: this script is allowed by hash in src/_headers (/share/ + /share/signin/ CSP). Change it → recompute the hash there. -->
<script>
  (function () {
    function getTheme() {
      var t = null;
      try { t = localStorage.getItem('rs-theme'); } catch (e) {}
      var m = document.cookie.match('(?:^|; )rs-theme=([^;]*)');
      if (m) {
        if (!t) { t = decodeURIComponent(m[1]); try { localStorage.setItem('rs-theme', t); } catch (e) {} }
        document.cookie = 'rs-theme=; max-age=0; path=/; domain=.refueler.io; SameSite=Lax';
      }
      return t === 'paper' ? 'paper' : 'carbon';
    }
    function setTheme(t) {
      try { localStorage.setItem('rs-theme', t); } catch (e) {}
    }
    function applyTheme(theme) {
      var root = document.documentElement;
      var pill = document.getElementById('themePill');
      if (theme === 'carbon') {
        root.dataset.theme = 'carbon';
        if (pill) pill.textContent = 'Carbon / Paper';
      } else {
        delete root.dataset.theme;
        if (pill) pill.textContent = 'Paper / Carbon';
      }
      var tint = document.querySelector('meta[name="theme-color"]');
      var bg = getComputedStyle(root).getPropertyValue('--bg').trim();
      if (tint && bg) tint.setAttribute('content', bg);
    }
    window.toggleTheme = function () {
      var next = getTheme() === 'paper' ? 'carbon' : 'paper';
      setTheme(next);
      applyTheme(next);
      {% if stripeThemeRemount %}if (typeof remountStripeForTheme === 'function') remountStripeForTheme();{% endif %}
    };
    applyTheme(getTheme());
    document.addEventListener('DOMContentLoaded', function () {
      applyTheme(getTheme());
    });
    window.toggleNavDrawer = function () {
      var h = document.getElementById('site-header');
      if (h) h.classList.toggle('nav-open');
    };
    document.addEventListener('click', function (e) {
      var h = document.getElementById('site-header');
      if (h && h.classList.contains('nav-open') && !h.contains(e.target)) {
        h.classList.remove('nav-open');
      }
    });
  }());
</script>
