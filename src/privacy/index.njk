      <div class="section-label" id="label-contact">08 · Contact</div>
      <div class="section-body">
        <div class="inset-card contact-card">
          <p><strong>Email:</strong> <a href="mailto:privacy@refueler.io">privacy@refueler.io</a></p>
          <p><strong>Post:</strong> [Registered address — to be confirmed at incorporation]</p>
          <p><strong>ICO registration:</strong> [Number to be added prior to publication]</p>
        </div>
        <p>Every privacy enquiry is read and answered personally.</p>
      </div>
    </section>

