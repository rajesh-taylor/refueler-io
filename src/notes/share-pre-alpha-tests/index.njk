<script>
/* Memory readout for the full-screen chart. Reads the samples above; no network, no storage. */
(function () {
  var svg = document.querySelector('.plot-live');
  if (!svg) return;
  var samples = JSON.parse(document.getElementById('memory-samples').textContent); // [GB downloaded, GB memory]
  var wrap = svg.parentNode, tip = wrap.querySelector('.plot-tip');
  var g = svg.querySelector('.readout'), cross = g.querySelector('.cross');
  var dotFile = g.querySelector('.dot-file'), dotMem = g.querySelector('.dot-mem');
  var X = function (gb) { return 48 + gb * 4.16; }, Y = function (gb) { return 256 - gb * 2.32; };
  var current = -1;

  function nearest(gb) {
    var best = 0;
    for (var i = 1; i < samples.length; i++) {
      if (Math.abs(samples[i][0] - gb) < Math.abs(samples[best][0] - gb)) best = i;
    }
    return best;
  }

  function show(i) {
    current = Math.max(0, Math.min(samples.length - 1, i));
    var s = samples[current], x = X(s[0]);
    cross.setAttribute('x1', x); cross.setAttribute('x2', x);
    dotFile.setAttribute('cx', x); dotFile.setAttribute('cy', Y(s[0]));
    dotMem.setAttribute('cx', x);  dotMem.setAttribute('cy', Y(s[1]));
    g.setAttribute('visibility', 'visible');
    tip.innerHTML = '<strong>' + s[0].toFixed(1) + ' GB</strong> downloaded<br>Safari\u2019s memory: <strong>' + s[1].toFixed(1) + ' GB</strong>';
    tip.hidden = false;
    // Place the window beside the point on the diagonal, flipped near the right edge.
    var m = svg.getScreenCTM(), r = wrap.getBoundingClientRect();
    var pt = svg.createSVGPoint(); pt.x = x; pt.y = Y(s[0]);
    var p = pt.matrixTransform(m);
    var left = p.x - r.left, top = p.y - r.top;
    tip.classList.toggle('flip', s[0] > 60);
    tip.style.left = left + 'px';
    tip.style.top = top + 'px';
  }

  function hide() { g.setAttribute('visibility', 'hidden'); tip.hidden = true; }

  svg.addEventListener('pointermove', function (e) {
    var pt = svg.createSVGPoint(); pt.x = e.clientX; pt.y = e.clientY;
    var p = pt.matrixTransform(svg.getScreenCTM().inverse());
    show(nearest((p.x - 48) / 4.16));
  });
  svg.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hide(); });
  svg.addEventListener('blur', hide);
  svg.addEventListener('keydown', function (e) {
    var step = e.shiftKey ? 10 : 1;
    if (e.key === 'ArrowRight') { e.preventDefault(); show(current < 0 ? 0 : current + step); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(current < 0 ? samples.length - 1 : current - step); }
    else if (e.key === 'Home') { e.preventDefault(); show(0); }
    else if (e.key === 'End') { e.preventDefault(); show(samples.length - 1); }
  });
}());
</script>

