---
title: "Notes — Refueler"
description: "Technical notes and commentary on privacy, Bitcoin, and the industries we work in."
canonical: "https://refueler.io/notes/"
activePage: notes
permalink: /notes/index.html
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
{% include "head.njk" %}
<link rel="preload" href="{{ '/notes/notes.css' | cssv }}" as="style">
<link rel="preload" href="/notes/notes.js" as="script">
<link rel="stylesheet" href="{{ '/notes/notes.css' | cssv }}">
</head>
<body>

{% include "nav.njk" %}

<main>
  <section class="notes-header">
    <p class="section-eyebrow">Refueler / Notes</p>
    <h1 class="section-title">Notes &amp; commentary.</h1>
    <p class="section-standfirst">The detail behind the products, and commentary on privacy, Bitcoin, and the industries we work in.</p>
  </section>

  <div class="notes-grid-wrap">
    <div class="notes-grid">

      {#- Cards come from each article's front matter (collections.notes, newest first) #}
      {%- for note in collections.notes %}
      <a class="note-card" href="{{ note.url }}">
        <div class="card-tags">
          {%- for topic in note.data.topics %}
          {%- if not loop.first %}
          <span class="card-dot"></span>
          {%- endif %}
          <span class="card-tag">{{ topic }}</span>
          {%- endfor %}
        </div>
        <h2 class="card-title">{{ note.data.cardTitle }}</h2>
        <p class="card-description">{{ note.data.summary }}</p>
        <div class="card-meta">
          <span>{{ note.date | monthYear }}</span>
          <span class="card-dot"></span>
          <span>{{ note.data.readTime }}</span>
        </div>
      </a>
      {%- endfor %}

    </div>
  </div>
</main>

{% include "footer.njk" %}

<script src="/notes/notes.js"></script>
<script src="/analytics.js" defer></script>
</body>
</html>
